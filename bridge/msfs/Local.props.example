<Project>
  <!--
    Copy to Local.props (gitignored) and point MsfsSdk at the root of the official MSFS SDK (T73):
      <MsfsSdk>\SimConnect SDK\include\SimConnect.h
      <MsfsSdk>\SimConnect SDK\lib\static\SimConnect.lib
    The build compiles native\acars_simconnect.cpp against them (Visual Studio Build Tools 2022, C++ x64 tools).
    A value passed on the command line (-p:MsfsSdk=...) still wins.
  -->
  <PropertyGroup>
    <MsfsSdk Condition="'$(MsfsSdk)' == ''">C:\MSFS 2024 SDK</MsfsSdk>
  </PropertyGroup>
</Project>
