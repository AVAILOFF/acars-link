{
  "name": "acars-sim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm spdx && pnpm test",
    "spdx": "node tools/spdx/check.mjs",
    "desktop:dev": "pnpm -F @acars/desktop dev",
    "desktop": "pnpm -F @acars/desktop build && pnpm -F @acars/desktop start",
    "desktop:dist": "node tools/release/build.mjs public",
    "desktop:dist:personal": "node tools/release/build.mjs personal",
    "release": "node tools/release/release.mjs",
    "licenses": "node tools/licenses/collect.mjs",
    "icon": "pnpm -F @acars/desktop exec electron ../../tools/icon/render.mjs",
    "bridge:build": "dotnet build bridge/msfs",
    "bridge:publish": "node -e \"for(const d of ['bridge/msfs/publish','bridge/msfs/symbols'])require('node:fs').rmSync(d,{recursive:true,force:true})\" && dotnet publish bridge/msfs/src/AcarsBridge -c Release -r win-x64 --self-contained -o bridge/msfs/publish",
    "bridge:test": "dotnet test bridge/msfs",
    "bridge:smoke": "node tools/release/smoke-bridge.mjs bridge/msfs/publish",
    "replay": "pnpm -F @acars/core -F @acars/scenarios -F @acars/replay build && node tools/replay/dist/cli.js",
    "hoppie:telex": "pnpm -F @acars/core -F @acars/transport build && pnpm -F @acars/transport telex"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
