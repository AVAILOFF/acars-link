{
  "name": "acars-sim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "desktop:dev": "pnpm -F @acars/desktop dev",
    "desktop": "pnpm -F @acars/desktop build && pnpm -F @acars/desktop start",
    "desktop:dist": "pnpm bridge:publish && pnpm licenses && pnpm -F @acars/desktop dist",
    "licenses": "node tools/licenses/collect.mjs",
    "icon": "pnpm -F @acars/desktop exec electron ../../tools/icon/render.mjs",
    "bridge:build": "dotnet build bridge/msfs",
    "bridge:publish": "dotnet publish bridge/msfs/src/AcarsBridge -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -o bridge/msfs/publish",
    "bridge:test": "dotnet test bridge/msfs",
    "replay": "pnpm -F @acars/core -F @acars/scenarios -F @acars/replay build && node tools/replay/dist/cli.js",
    "hoppie:telex": "pnpm -F @acars/core -F @acars/transport build && pnpm -F @acars/transport telex"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
